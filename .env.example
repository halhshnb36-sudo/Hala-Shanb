# Copy to .env.local for local development. NEVER commit real values.
# These are PUBLIC browser values (safe by design when RLS is enabled).
# The Supabase service_role key must NEVER be placed here or in any VITE_* variable.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" key, from Supabase > Project Settings > API Keys
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Final public address of the site (used for absolute Open Graph URLs). No trailing slash.
VITE_SITE_URL=https://your-domain.example

# Optional: override the resumable-upload host (needed only for custom Supabase domains / self-hosting).
# Default is derived from VITE_SUPABASE_URL as https://<ref>.storage.supabase.co
# VITE_SUPABASE_STORAGE_URL=
